# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

build/
bin/
.gradle
.idea

*.jfr
# Markers the test-recordings generator writes next to a recording it generated
*.jfr.generated
# Exception: TCK test recording needed for CI
!jfr-shell-tck/src/main/resources/tck-test.jfr
# Exception: small stripped regression fixtures committed directly
!parser-core/src/test/resources/dd-trace-java-stripped/*.jfr
# Shared Java/Go parser fixtures, built by parser-core's NodePoolFixture (see SharedFixturesTest)
!go-parser/jfr/testdata/*.jfr
**/.DS_Store

harness*
launcher*

/lib/

# Keep top-level gradle.properties, ignore others
gradle.properties
**/gradle.properties

# cursor history
.history
/.githooks/pre-commit
/.vscode/settings.json

**/.last_build_hash

# Temporary documentation
doc/temp/

# Sphinx review session state (credentials, reports)
.sphinx/

# jqwik test run state
.jqwik-database

# Jazzer's coverage-guided corpus, grown by a local fuzz session (JAZZER_FUZZ=1); the nightly
# uploads it as an artifact and nothing commits it (doc/agents/Gates.md)
parser-core/.cifuzz-corpus/

# Working notes from investigation sessions; not part of the repository
scratch/
